# Disable index view
#Options -Indexes
Options +FollowSymLinks -MultiViews -Indexes

# Hide a specific file
<Files .env>
    Order allow,deny
    Deny from all
</Files>

<Files package.json>
    Order allow,deny
    Deny from all
</Files>

<Files composer.json>
    Order allow,deny
    Deny from all
</Files>

<Files composer.lock>
    Order allow,deny
    Deny from all
</Files>


#Hide .git
RedirectMatch 404 /\.git
RedirectMatch 404 \.json$
RedirectMatch 404 \.yml$
